{
  "name": "llm-leaderboard",
  "version": "0.1.0",
  "private": true,
  "description": "Scrape the Artificial Analysis LLM leaderboard and browse/filter it locally.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "llm-leaderboard": "dist/index.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:site": "tsx src/index.ts export --out site",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "refresh": "tsx src/index.ts refresh",
    "serve": "tsx src/index.ts serve",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.11",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3"
  }
}
