{
  "compilerOptions": {
    // cordis ships `lib/index.d.ts` with extensionless relative imports
    // (export * from './service'), which Node's ESM rules reject — `nodenext`
    // resolution therefore cannot see its own type exports. Bundler resolution
    // permits extensionless specifiers and still honours the exports map.
    // Our own imports keep explicit `.js` extensions, so the emitted ESM is valid.
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
